# ------------------------------------------------------------
# Ejercicio 1: Calculando el salario semanal
# ------------------------------------------------------------

print("Ejercicio 1: Calculando el salario semanal")

ventas_totales = float(input("Ingrese el total de ventas del vendedor: "))

salario_base = 500
comision = ventas_totales * 0.10
salario_total = salario_base + comision

print("El salario total del vendedor es:", salario_total)


# ------------------------------------------------------------
# Ejercicio 2: Fruteria virtual
# ------------------------------------------------------------

print("\nEjercicio 2: Fruteria virtual")

catalogo_frutas = {
    "manzana": 1200,
    "banana": 900,
    "naranja": 1000,
    "pera": 1500
}

fruta = input("Ingrese el nombre de una fruta: ").lower()

if fruta in catalogo_frutas:
    print("El precio de la", fruta, "es:", catalogo_frutas[fruta])
else:
    print("La fruta no se encuentra en nuestra tienda.")


