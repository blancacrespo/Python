# Ejercicio 4: Calculadora de chocolate
# ------------------------------------------------------------

print("\nEjercicio 4: Calculadora de chocolate")

limite_calorias = int(input("Ingrese su limite diario de calorias: "))
calorias_chocolate = int(input("Ingrese las calorias de una porcion de chocolate: "))

cantidad_maxima = limite_calorias // calorias_chocolate

print("Puedes comer hasta", cantidad_maxima, "porciones de chocolate sin exceder tu limite diario.")


